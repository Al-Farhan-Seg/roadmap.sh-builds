{
  "name": "roadmap.sh-builds",
  "version": "1.0.0",
  "private": true,
  "description": "A collection of static and React frontend projects based on roadmap.sh briefs.",
  "type": "module",
  "workspaces": [
    "14-age-calculator",
    "15-flash-cards",
    "21-quiz-app",
    "22-weather-web-app",
    "23-github-random-repository",
    "26-reddit-client",
    "28-pomodoro-timer",
    "30-24hr-story-feature"
  ],
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "css:watch": "tailwindcss -i ./tailwind.input.css -o ./top_assets/tailwind.css --watch",
    "css:build": "tailwindcss -i ./tailwind.input.css -o ./top_assets/tailwind.css",
    "css:build:prod": "tailwindcss -i ./tailwind.input.css -o ./top_assets/tailwind.css --minify",
    "dev:14": "npm run dev --workspace=14-age-calculator --",
    "dev:15": "npm run dev --workspace=15-flash-cards -- --",
    "dev:21": "npm run dev --workspace=21-quiz-app --",
    "dev:22": "npm run dev --workspace=22-weather-web-app --",
    "dev:23": "npm run dev --workspace=23-github-random-repository --",
    "dev:26": "npm run dev --workspace=26-reddit-client --",
    "dev:28": "npm run dev --workspace=28-pomodoro-timer --",
    "dev:30": "npm run dev --workspace=30-24hr-story-feature --",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Al-Farhan-Seg/roadmap.sh-builds.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3"
  }
}
